# Protection system strings (1.5.21)
msgid "Protect from deletion"
msgstr "Protéger de la suppression"

msgid "Protect this file from being listed as unused or deleted by Media Cleaner"
msgstr "Protéger ce fichier de la liste des médias inutilisés et de la suppression par Media Cleaner"

msgid "When checked, Media Cleaner will never flag this file as unused and will refuse any deletion attempts."
msgstr "Lorsque cette case est cochée, Media Cleaner ne listera jamais ce fichier comme inutilisé et refusera toute tentative de suppression."

msgid "Protection Settings"
msgstr "Paramètres de protection"

msgid "Protect specific files from being listed as unused or deleted. Enter one path, URL, or glob pattern per line."
msgstr "Protégez des fichiers spécifiques de la liste des médias inutilisés et de la suppression. Entrez un chemin, une URL ou un motif glob par ligne."

msgid "Protected Paths"
msgstr "Chemins protégés"

#. translators: Example patterns for protected paths
msgid "Examples:\n2024/03/logo_osm_2019.png\n2023/*/header-*.jpg\nhttps://example.com/wp-content/uploads/2024/03/logo.png"
msgstr "Exemples :\n2024/03/logo_osm_2019.png\n2023/*/header-*.jpg\nhttps://example.com/wp-content/uploads/2024/03/logo.png"

msgid "Use * wildcards for glob patterns. Paths are relative to the uploads directory. Derivatives (thumbnails, WebP) are automatically protected when the original is protected."
msgstr "Utilisez des jokers * pour les motifs glob. Les chemins sont relatifs au répertoire des téléversements. Les dérivés (vignettes, WebP) sont automatiquement protégés lorsque l'original est protégé."

msgid "Per-File Protection"
msgstr "Protection par fichier"

msgid "Individual files can also be protected using the \"Protect from deletion\" checkbox in the attachment edit screen or media modal."
msgstr "Les fichiers individuels peuvent également être protégés à l'aide de la case à cocher « Protéger de la suppression » dans l'écran de modification de la pièce jointe ou dans la fenêtre modale des médias."

msgid "Save Protection Settings"
msgstr "Enregistrer les paramètres de protection"

msgid "Protection settings saved."
msgstr "Paramètres de protection enregistrés."

msgid "This file is protected and cannot be trashed."
msgstr "Ce fichier est protégé et ne peut pas être mis à la corbeille."

msgid "This file is protected and cannot be deleted."
msgstr "Ce fichier est protégé et ne peut pas être supprimé."

#. translators: %d: number of files
msgid "%d protected file skipped."
msgid_plural "%d protected files skipped."
msgstr[0] "%d fichier protégé ignoré."
msgstr[1] "%d fichiers protégés ignorés."

#. translators: %d: number of media items that are still in use
msgid "%d used media item was kept."
msgid_plural "%d used media items were kept."
msgstr[0] "%d média utilisé a été conservé."
msgstr[1] "%d médias utilisés ont été conservés."

msgid "No files were trashed."
msgstr "Aucun fichier n'a été mis à la corbeille."

msgid "No files were deleted."
msgstr "Aucun fichier n'a été supprimé."

msgid "%d protected file in trash cannot be deleted."
msgid_plural "%d protected files in trash cannot be deleted."
msgstr[0] "%d fichier protégé dans la corbeille ne peut pas être supprimé."
msgstr[1] "%d fichiers protégés dans la corbeille ne peuvent pas être supprimés."

#. translators: %d: number of files
msgid "%d protected file in trash was not deleted."
msgid_plural "%d protected files in trash were not deleted."
msgstr[0] "%d fichier protégé dans la corbeille n'a pas été supprimé."
msgstr[1] "%d fichiers protégés dans la corbeille n'ont pas été supprimés."

#. translators: Example patterns for protected paths with ** syntax
msgid "Examples:\n2024/03/logo_osm_2019.png\n2023/*/header-*.jpg\n2024/**/receipts/*.pdf\nhttps://example.com/wp-content/uploads/2024/03/logo.png"
msgstr "Exemples :\n2024/03/logo_osm_2019.png\n2023/*/header-*.jpg\n2024/**/receipts/*.pdf\nhttps://example.com/wp-content/uploads/2024/03/logo.png"

msgid "Use * wildcards for glob patterns: * matches within one directory segment, ** matches across segments. Paths are relative to the uploads directory. Derivatives (thumbnails, WebP) are automatically protected when the original is protected."
msgstr "Utilisez des jokers * pour les motifs glob : * correspond à un segment de répertoire, ** correspond à plusieurs segments. Les chemins sont relatifs au répertoire des téléversements. Les dérivés (vignettes, WebP) sont automatiquement protégés lorsque l'original est protégé."

msgid "Pattern Match Counts:"
msgstr "Nombre de correspondances par motif :"

#. translators: %d: number of files
msgid "%d file"
msgstr "%d fichier"

#. translators: %d: number of files
msgid "%d files"
msgstr "%d fichiers"

msgid "No matches (possible typo?)"
msgstr "Aucune correspondance (erreur de frappe ?)"
