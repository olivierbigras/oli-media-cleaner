#. Plugin Name of the plugin
#: oli-media-cleaner.php
msgid "Oli Media Cleaner"
msgstr "Oli Media Cleaner"

#. Plugin URI of the plugin
#: oli-media-cleaner.php
msgid "https://github.com/olivierbigras/oli-media-cleaner"
msgstr "https://github.com/olivierbigras/oli-media-cleaner"

#. Description of the plugin
#: oli-media-cleaner.php
msgid ""
"Find unused media, move them to a safe trash, restore anytime. Local only: "
"no ads, no tracking, nothing sent out."
msgstr ""
"Trouvez les médias inutilisés, mettez-les à la corbeille en toute sécurité, "
"restaurez-les à tout moment. Fonctionne en local : aucune publicité, aucun "
"suivi, rien n’est envoyé à l’extérieur."

#. Author of the plugin
#: oli-media-cleaner.php
msgid "Olivier Bigras"
msgstr "Olivier Bigras"

